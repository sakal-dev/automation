# /etc/sakal-worker.env — SHAPES ONLY. Copy to the VPS, fill with real
# values, chmod 600. Credentials NEVER live in this repo.

# ── which queue ─────────────────────────────────────────────────────────────
SOURCE=github                # github | sakalmaster
REPO=sakal-dev/sakalpos-garage

# ── agent auth ──────────────────────────────────────────────────────────────
CLAUDE_CODE_OAUTH_TOKEN=     # from `claude setup-token` (human-minted)
GH_TOKEN=                    # PAT: issues+contents+pull-requests write on REPO
                             # (PRs opened with it trigger CI — never the
                             # workflow GITHUB_TOKEN trap here)

# ── sakalmaster mode only ───────────────────────────────────────────────────
#SAKAL_SUPABASE_URL=https://xxxx.supabase.co   # the SUPABASE project URL, not the web app
#SAKAL_SUPABASE_PUBLISHABLE_KEY=              # sb_publishable_… (public)
#SAKAL_TOKEN=                # sakal_pat_… service-account PAT
#PROJECT=                    # project uuid
#APP=                        # app key — REQUIRED once sakal-dev/sakalmaster#1 lands

# ── knobs (defaults shown) ──────────────────────────────────────────────────
#POLL_SECONDS=300
#MAX_TURNS=150
#TASK_TIMEOUT_SECONDS=3600
#HEARTBEAT_SECONDS=120
#LEASE_SECONDS=1800
# Firewall additions for the repo's registries (stack knowledge stays DATA):
#EXTRA_ALLOW_DOMAINS=pub.dev storage.googleapis.com
#SKIP_FIREWALL=0             # 1 only for local dev, never on a VPS
